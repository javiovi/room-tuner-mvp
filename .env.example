# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/_/settings/api

# Project URL (https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here

# Anon/Public Key (safe to expose to client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key (NEVER expose to client - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Paywall (dormant during open testing) ──
# The full report is unlocked for everyone unless this is exactly "true".
# Turn it on only once the paid tiers and the payment flow are ready.
NEXT_PUBLIC_PAYWALL=false

# Dev/QA escape hatch: unlocks the report even with the paywall on.
# Also available per visit as ?unlock=1 or localStorage.roomtuner_force_unlock
NEXT_PUBLIC_FORCE_UNLOCK=false

# ── Live pricing (off by default) ──
# MercadoLibre answers 403 to server-to-server requests from cloud IPs, so the server-side
# price lookup is skipped unless this is "true". Catalog prices are used either way.
ENABLE_ML_PRICING=false
